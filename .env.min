# The minimum environment of the platform.
#
# The platform is three services and the infrastructure they share. The
# stacks of the deployment read their variables from the environment of
# the shell, and a variable that is not set stops the stack before the
# first request. This file holds the variables they read, and it is the
# answer to the question "what does the platform need to come up".
#
#   docker compose --env-file .env.min \
#     -f deploy/compose/production/platform.compose.yaml up -d
#
# A variable that a stack refuses to start without is marked as
# required. The other ones have a default in the stack, and they are
# here so that the values of the deployment are explicit.
#
# The values are example values, and they are not secrets: they are the
# values of the example of the platform, and a deployment replaces every
# one of them with a secret of its own, out of a secret store and not
# out of a file of the repository.
#
# The two private keys below are placeholders, because a private key is
# not a value of a repository:
#
#   bun run scripts/dev-keys.ts                     the pair of the gateway
#   openssl ecparam -genkey -name prime256v1 -noout  the key of the access service
#
# The file is the counterpart of `.env.example`: that one holds every
# variable of the three services, this one holds only the variables of a
# deployment.

# ---------------------------------------------------------------------------
# The PostgreSQL server and the roles of the services
# ---------------------------------------------------------------------------
# The password of the administrator of the server. Required: the stacks
# of the platform build the urls of the roles of the services with it.
POSTGRES_PASSWORD=platform
# The password of the role of the access service. Required.
ACCESS_APP_PASSWORD=access_app
# The passwords of the roles of the data service: the owner of the
# schema, the api, the reader of the registry, the metadata of the
# deliveries and the retention. Required.
DATA_OWNER_PASSWORD=dev-owner-password-0001
DATA_RUNTIME_PASSWORD=dev-runtime-password-0001
DATA_REGISTRY_PASSWORD=dev-registry-password-0001
DATA_DELIVERY_PASSWORD=dev-delivery-password-0001
DATA_MAINTENANCE_PASSWORD=dev-maintenance-password-0001

# ---------------------------------------------------------------------------
# The access service (the OpenID Connect broker and the decisions)
# ---------------------------------------------------------------------------
# The url the browser and the gateway reach the service at. It is the
# `iss` of every token that the service issues. Required.
ACCESS_ISSUER=http://localhost:8081
# The bearer token of the administration. Required.
ACCESS_ADMIN_TOKEN=example-admin-token-0000000
# The bearer token the gateway presents on `POST /v1/decisions`.
# Required. It is the same value as `GATEWAY_ACCESS_TOKEN` below.
ACCESS_DECISION_TOKEN=example-access-token-0000000
# The credentials of the access context contract: the keys are the
# bearer tokens and the values are the tenants every token may ask
# about. A null value is a credential of the platform: it may ask about
# every tenant. Required. The key below is the credential of the file
# `ACCESS_CONTEXT_TOKEN_FILE` below.
ACCESS_CONTEXT_TOKENS='{"development-access-context-token-0001":null}'
# The secret that signs and encrypts the state of a login. At least 32
# bytes, and the same on every replica. Required.
ACCESS_STATE_SECRET=0f7c1d9a4b2e6835a9c4d7e1b3f5a8c2
# The key that encrypts the client secrets of the tenants at rest. At
# least 32 bytes. Required.
ACCESS_SECRET_ENCRYPTION_KEY=3b9d5f1e7a0c48269d1e5f8b3c7a2d046
# The private key the service signs its tokens with, in PEM, and the
# identifier of the key in the JWKS. Required. The value of the key is
# a placeholder.
ACCESS_SIGNING_KEY=REPLACE_WITH_A_PEM_PRIVATE_KEY
ACCESS_SIGNING_KID=access-1
# The database of the five tables of the service. Required by the stack
# of the access service alone: the composition builds the url of the
# role of the service with `ACCESS_APP_PASSWORD`.
ACCESS_DATABASE_URL=postgres://access_app:access_app@postgres:5432/platform
# The shared store of the authorization codes. Required by the stack of
# the access service alone.
ACCESS_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# The data service (the headless data backend)
# ---------------------------------------------------------------------------
# The url of the access service of the access context contract. Required.
DATA_ACCESS_URL=http://access:8081
# The credential of the api of the service: the database of the business
# data. Required by the stack of the data service alone.
DATA_DATABASE_URL=postgres://data_runtime:dev-runtime-password-0001@postgres:5432/data
# The narrow reader of the registry of the workspaces. Required by the
# stack of the data service alone.
DATA_REGISTRY_DATABASE_URL=postgres://data_registry:dev-registry-password-0001@postgres:5432/data
# The administrator of the server and the owner of the schema. Required
# by the stack of the data service alone: the composition builds their
# urls with `POSTGRES_PASSWORD`.
DATA_ADMIN_DATABASE_URL=postgres://platform:platform@postgres:5432/postgres
DATA_OWNER_DATABASE_URL=postgres://platform:platform@postgres:5432/data

# ---------------------------------------------------------------------------
# The gateway (the HTTP gateway)
# ---------------------------------------------------------------------------
# The issuer of the identity provider. Required.
GATEWAY_OIDC_ISSUER=http://access:8081
# The identifier of the client the gateway registers with the provider.
GATEWAY_OIDC_CLIENT_ID=platform
# The secret of the client. Required.
GATEWAY_OIDC_CLIENT_SECRET=example-client-secret-0000000
# The url the provider sends the browser back to. Required.
GATEWAY_OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
# The url of the access service, and the token the gateway
# authenticates with. Required by the stack of the gateway alone. The
# token is the value of `ACCESS_DECISION_TOKEN` above.
GATEWAY_ACCESS_URL=http://access:8081
GATEWAY_ACCESS_TOKEN=example-access-token-0000000
# The secret that signs the state cookie of the login flow. The same
# value on every replica. Required.
GATEWAY_SESSION_SECRET=9e2f7c1d4b6a8035d1c9f2e7b5a4d083
# The private key that signs the identity of the requests, in PEM. It is
# the private half of `deploy/secrets/identity-signing.pem`, and the
# public half of the pair is the file `GATEWAY_IDENTITY_PUBLIC_KEY`
# below. Required. The value is a placeholder.
GATEWAY_IDENTITY_SIGNING_KEY=REPLACE_WITH_THE_PRIVATE_HALF_OF_THE_PAIR
# The bearer token that guards `/metrics`. Required.
GATEWAY_METRICS_TOKEN=example-metrics-token-0000000
# At least one rate limit has to be set: the gateway refuses to start in
# a production environment without one.
GATEWAY_RATE_LIMIT_TOTAL_MAX=1000

# ---------------------------------------------------------------------------
# The files of the credentials
# ---------------------------------------------------------------------------
# The paths are relative to the directory of the stack, and the stack
# mounts them where the services read them. A deployment mounts the
# files of its own secret manager instead of the fixtures of the
# repository. Required.
# The credential of the access context contract: the key of
# `ACCESS_CONTEXT_TOKENS` above.
ACCESS_CONTEXT_TOKEN_FILE=../../fixtures/secrets/access-context.token
# The key that signs the cursors of the pages.
CURSOR_KEY_FILE=../../fixtures/secrets/cursor.key
# The public half of the pair of `GATEWAY_IDENTITY_SIGNING_KEY`. The
# script of the keys of the root writes it:
#
#   bun run scripts/dev-keys.ts
#
GATEWAY_IDENTITY_PUBLIC_KEY=../../secrets/identity-signing.public.pem
