{
  "name": "platform",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-native identity, modeling, grants and row security, with a static interface that speaks to PostgreSQL itself.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun --bun run --cwd examples/newsroom vite",
    "build": "bun --bun run --cwd examples/newsroom vite build",
    "relay": "bun packages/relay/src/relay.ts",
    "deploy": "bun packages/cli/src/cli.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lines": "bun scripts/lines.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run build && bun run typecheck && bun run lint && bun run format:check && bun run lines && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
