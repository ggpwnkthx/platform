{
  "name": "platform",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-native identity, modeling, grants and row security, with a static interface that speaks to PostgreSQL itself.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "examples:newsroom:build": "bun packages/cli/src/cli.ts ui build --dir=examples/newsroom",
    "examples:newsroom:dev": "bun packages/cli/src/cli.ts ui dev --dir=examples/newsroom",
    "cli": "bun packages/cli/src/cli.ts",
    "relay": "bun packages/relay/src/relay.ts",
    "migrate": "bun packages/cli/src/cli.ts migrate",
    "deploy": "bun packages/cli/src/cli.ts deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lines": "bun packages/cli/src/lines.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run examples:newsroom:build --production && bun run examples:newsroom:build && bun run typecheck && bun run lint && bun run format:check && bun run lines && bun test",
    "test:e2e": "node packages/ui/test/e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
