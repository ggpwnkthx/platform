{
  "name": "platform",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL-native identity, modeling, grants and row security, with a static interface that speaks to PostgreSQL itself.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:ui": "bun packages/ui/scripts/build.tsx",
    "dev:ui": "bun packages/ui/scripts/dev.ts",
    "cli": "bun packages/cli/src/cli.ts",
    "migrate": "bun packages/cli/src/cli.ts migrate",
    "deploy": "bun packages/cli/src/cli.ts deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run build:ui && bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
