# The settings of a deployment. A checkout has none: `bun run deploy` writes .env on the
# first run, from the environment and these defaults, with the one secret it generates. The
# file holds a secret, so it is written for you alone and kept out of git. This file is the
# reference of every setting it can hold.

# The domain the deployment is named by. Each service answers on its own sub-domain of it,
# and every address follows from the domain and the sub-domains.
PLATFORM_DOMAIN=localhost
# Dex, the OpenID Connect issuer PostgreSQL trusts.
PLATFORM_IDP_HOST=idp
# The relay, in front of PostgreSQL's port.
PLATFORM_API_HOST=api
# PostgreSQL.
PLATFORM_DB_HOST=db
# The site, when this deployment serves one.
PLATFORM_APP_HOST=app

# The site. Either a folder with a platform.json, which the local stack installs, builds and
# serves; or the full address of a site published elsewhere. The relay allows sessions from
# the site's origin alone.
# PLATFORM_SITE=examples/newsroom
# PLATFORM_PUBLIC_URL=https://www.example.com

# The administrator, as the token names them: `admin` on the deployment's domain unless said.
# PLATFORM_ADMIN=admin@localhost
# What Dex asks the break-glass administrator for. Generated on the first run; only its hash
# is given to Dex.
# PLATFORM_ADMIN_PASSWORD=
# Whether Dex keeps that one account with a password: 1 on localhost, unset elsewhere.
# DEX_LOCAL_ADMIN=1

# The ports of the local stack, on this machine. Never 80 or 443: a rootless container cannot
# bind those.
# EDGE_PORT=8080
# EDGE_TLS_PORT=4433
# POSTGRES_PORT=5432
# DEX_PORT=5556
# RELAY_PORT=8081

# Kubernetes: the relay image in your registry, and the port PostgreSQL listens on.
# PLATFORM_IMAGE=registry.example.com/platform-relay:3.0.0
# DATABASE_PORT=5432
