# The interface (Dockerfile target ui): written into /config.json and nginx's server block at
# start by deploy/ui/platform.sh. It holds no database credentials.
PUBLIC_URL=http://localhost:8080
# The OpenID Connect issuer people sign in through, and PostgreSQL trusts: your Dex.
OIDC_ISSUER=http://localhost:5556/dex
# OIDC_CLIENT_ID=platform-console
# OIDC_CLAIM=email
# RELAY_UPSTREAM=relay:8081
# SESSIONS_PER_ADDRESS=20
# LISTEN_PORT=8080
DATABASE_NAME=platform
STATEMENT_TIMEOUT_MS=15000

# CLI: where the operator's commands find the database. DATABASE_SSL and DATABASE_CA_FILE apply
# to the CLI's connections only; the relay reaches PostgreSQL in plain TCP.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_SSL=disable
# DATABASE_CA_FILE=/run/secrets/postgresql-ca.pem
# CLI only: PGTOKEN[_FILE] to act as a person, or PGUSER and PGPASSWORD[_FILE] to act as the
# installer's administrator. Never inject these into the interface or the relay.

# Deployment CLI: the PostgreSQL administrator password for the local stack. Left unset, the
# CLI generates one and appends it to .env.
# POSTGRES_PASSWORD=...
# POSTGRES_PASSWORD_FILE=/path/to/local-postgres-password
# The local stack's Dex keeps three example people; their passwords are generated likewise.
# PLATFORM_ADMIN_PASSWORD=...   admin@example.com
# ALICE_PASSWORD=...            alice@example.com
# BOB_PASSWORD=...              bob@example.com
# DEX_PORT=5556
# PLATFORM_HTTP_PORT=8080
# POSTGRES_PORT=5432
# Kubernetes deployment CLI: the interface image (Dockerfile target ui).
# PLATFORM_IMAGE=your-registry/platform-ui:2.1.0
# OIDC_ISSUER=https://sso.example.com/dex
