# The settings of a deployment. A checkout has none: `bun run cli deploy` writes this file
# on the first run, asking for what it does not know and generating the secrets. It holds
# secrets, so it is written for you alone and kept out of git. This file is the reference of
# every setting it can hold.

# The ports the edge answers on, on this machine. Never 80 or 443: a rootless container
# cannot bind those. A deployment that terminates TLS itself has no port in its names.
# EDGE_PORT=8080
# EDGE_TLS_PORT=4433

# The domain the deployment is named by. Each service answers on its own sub-domain of it,
# and the addresses below follow from the domain and the sub-domains.
PLATFORM_DOMAIN=localhost
# The sub-domain Dex, the OpenID Connect issuer PostgreSQL trusts, answers on.
PLATFORM_IDP_HOST=idp
# The sub-domain the relay, the API in front of PostgreSQL's port, answers on.
PLATFORM_API_HOST=api
# The sub-domain PostgreSQL answers on.
PLATFORM_DB_HOST=db

# The site: the address the pages are served from. The relay allows sessions from this
# origin alone. A site of your own is named by its full URL; left empty, an example is
# deployed on the sub-domain below, and its address follows from the domain.
# PLATFORM_PUBLIC_URL=https://platform.example.com
# The sub-domain an example is deployed on.
PLATFORM_APP_HOST=app
# The example that is deployed: the workspaces under examples/. Empty means the platform's
# own interface.
PLATFORM_EXAMPLE=

# The addresses below are made of the pieces above at runtime, and are not kept: they
# follow the domain, the sub-domains and the ports, and they are the same everywhere.
#   the issuer, Dex:            http://<PLATFORM_IDP_HOST>.<PLATFORM_DOMAIN>:<EDGE_PORT>
#   the relay, the API:         ws://<PLATFORM_API_HOST>.<PLATFORM_DOMAIN>:<EDGE_PORT>
#   an example's address:       http://<PLATFORM_APP_HOST>.<PLATFORM_DOMAIN>:5173
#   where PostgreSQL is:        <PLATFORM_DB_HOST>.<PLATFORM_DOMAIN>
# Set one of them in the environment when it has to be something else: the environment
# speaks last.
# PLATFORM_CLIENT_ID=platform-console
# PLATFORM_CLAIM=email
# PLATFORM_DATABASE_NAME=platform
# PLATFORM_STATEMENT_TIMEOUT_MS=15000

# The relay (Dockerfile target relay): where PostgreSQL listens, and who may open a session.
# RELAY_UPSTREAM=postgres:5432
# The ports the services answer on, behind the edge. They are the edge's backends, and
# reach nothing else: the addresses above carry no port.
# RELAY_PORT=8081
# RELAY_ORIGINS=https://platform.example.com
# RELAY_SESSIONS_PER_ADDRESS=20
# RELAY_SESSIONS_PER_ROLE=20
# RELAY_TLS_CERT=/run/secrets/relay-cert.pem
# RELAY_TLS_KEY=/run/secrets/relay-key.pem

# CLI: where the operator's commands find the database. DATABASE_SSL and DATABASE_CA_FILE apply
# to the CLI's connections only; the relay reaches PostgreSQL in plain TCP.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_SSL=disable
# DATABASE_CA_FILE=/run/secrets/postgresql-ca.pem
# CLI only: PGTOKEN[_FILE], the token of the person the command acts as (`bun run cli token`
# prints one). No login has a password. Never inject a token into the interface or the relay.

# Deployment CLI: PostgreSQL is given no password. The local stack's Dex keeps one account with
# a password, the break-glass administrator, and stands in for a real sign-in system; what it
# asks for is generated into .env when left unset. Every other account comes from a connector.
# PLATFORM_ADMIN=admin@localhost   the administrator: admin on the deployment's domain
# PLATFORM_ADMIN_PASSWORD=...      what Dex asks the administrator for
# DEX_PORT=5556
# RELAY_PORT=8081
# POSTGRES_PORT=5432
# Kubernetes deployment CLI: the relay image (Dockerfile target relay).
# PLATFORM_IMAGE=your-registry/platform-relay:2.1.0
# PLATFORM_DOMAIN=platform.example.com
# PUBLIC_URL=https://platform.example.com
# OIDC_ISSUER=https://sso.example.com/dex
