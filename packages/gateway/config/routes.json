{
  "version": 1,
  "defaults": {
    "auth": { "mode": "none" },
    "timeouts": { "responseMs": 5000, "firstByteMs": 30000, "bodyMs": 300000 },
    "maxBodyBytes": 10485760
  },
  "trustedProxies": [],
  "reservedPaths": [],
  "routes": [
    {
      "id": "public-site",
      "match": { "host": "app.gateway.test", "path": "/" },
      "upstream": "http://upstream-a:3000",
      "auth": { "mode": "none" }
    },
    {
      "id": "workspace-api",
      "match": { "host": "api.gateway.test", "path": "/ws/{workspaceId}/" },
      "upstream": "http://upstream-b:3000",
      "auth": { "mode": "any", "workspace": { "param": "workspaceId", "requireUuid": true } },
      "websocket": true,
      "maxBodyBytes": 5242880
    },
    {
      "id": "workspace-assets",
      "match": { "host": "api.gateway.test", "path": "/ws/{workspaceId}/assets/" },
      "upstream": "http://upstream-b:3000",
      "auth": { "mode": "any", "workspace": { "param": "workspaceId", "requireUuid": true } }
    },
    {
      "id": "catch-all-site",
      "match": { "host": "*.gateway.test", "path": "/" },
      "upstream": "http://upstream-a:3000",
      "auth": { "mode": "none" }
    }
  ]
}
