{
  "name": "@platform/access",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Access of the platform: an OpenID Connect broker that answers the decisions of the gateway.",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test src test/contract test/architecture",
    "test:unit": "bun test src",
    "test:contract": "bun test test/contract",
    "test:integration": "bun test test/integration",
    "test:architecture": "bun test test/architecture",
    "test:compatibility": "bun test test/compatibility",
    "test:compat": "bun run scripts/compat/compatibility.ts",
    "typecheck": "tsc --noEmit",
    "architecture": "bun run scripts/gates/architecture.ts",
    "versions": "bun run scripts/gates/version.ts",
    "load": "bun run scripts/ops/load.ts",
    "provision": "bun run scripts/cli/provision.ts",
    "admin:smoke": "bun run scripts/cli/admin-smoke.ts",
    "rotate:secrets": "bun run scripts/cli/rotate-secrets.ts",
    "shadow": "bun run scripts/compat/shadow.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
