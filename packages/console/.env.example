# The environment of the console.
#
# The variables are in docs/console/operations.md. Every value of this
# file is a value of a development machine and not a secret of a
# deployment.

# development serves the sources through Vite; production serves dist/.
CONSOLE_ENVIRONMENT=development
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8083
CONSOLE_PUBLIC_URL=http://localhost:8083

# The access service, and the client of the tenant at it. The tenant
# registers http://localhost:8083/auth/callback among its redirects.
CONSOLE_ACCESS_URL=http://127.0.0.1:8081
CONSOLE_CLIENT_ID=platform
CONSOLE_CLIENT_SECRET=dev-gateway-client-secret-00001

# The gateway: the data of a workspace is read through it. The data
# service is probed directly.
CONSOLE_GATEWAY_URL=http://localhost:8080
CONSOLE_DATA_URL=http://127.0.0.1:8082

# The credentials the console acts with.
CONSOLE_ACCESS_CONTEXT_TOKEN=dev-context-token-00000001
CONSOLE_ADMIN_TOKEN=dev-admin-token-0000000
CONSOLE_TENANT_ADMIN_TOKENS={"acme":"dev-tenant-token-of-the-development-01"}
CONSOLE_ROUTE_ID=console

# The secret of the cookies: 32 characters at least.
CONSOLE_SESSION_SECRET=dev-console-session-secret-of-the-dev-01
CONSOLE_LOG_LEVEL=info
